{
  "name": "246sports-backend",
  "version": "2.0.0",
  "description": "Multi-tenant national sports platform for Barbados - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "start:check": "node scripts/startup-check.js",
    "prestart": "node scripts/startup-check.js",
    "db:migrate": "./database/migrate.sh",
    "db:setup": "psql -U postgres -d sports_db -f database/schema.sql",
    "db:seed": "psql -U postgres -d sports_db -f database/seeds.sql",
    "test": "echo \"Tests not yet implemented\" && exit 1",
    "test:email": "ts-node src/scripts/test-email.ts",
    "debug:email": "ts-node src/scripts/debug-email.ts",
    "setup:ethereal": "ts-node src/scripts/ethereal-setup.ts",
    "build:check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "sports",
    "api",
    "barbados",
    "multi-tenant",
    "competitions",
    "fixtures"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/express-rate-limit": "^5.1.3",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^7.0.11",
    "@types/winston": "^2.4.4",
    "bcrypt": "^6.0.0",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.2",
    "pg": "^8.19.0",
    "slugify": "^1.6.6",
    "uuid": "^13.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.18.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
