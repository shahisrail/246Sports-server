# Server Configuration
NODE_ENV=development
PORT=4000

# Database Configuration
# For PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sports246
# Alternative: Individual DB parameters (used only if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sports246
# DB_USER=postgres
# DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:3001

# Logging
LOG_LEVEL=debug

# Email Configuration (SMTP) - Choose ONE:
#
# Option 1: Ethereal Email (Recommended for Testing)
# - Automatic setup: npm run setup:ethereal
# - View emails at: https://ethereal.email/messages
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-ethereal-user@ethereal.email
# SMTP_PASS=your-ethereal-password
#
# Option 2: Mailtrap Sandbox
# - Get credentials at: https://mailtrap.io
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your-mailtrap-username
# SMTP_PASS=your-mailtrap-password
#
# Option 3: Gmail (For Production - Low Volume)
# - Requires App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
#
# Option 4: Hostinger Email (Production)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-mailbox@your-domain.com
# SMTP_PASS="your-mailbox-password"
#
# Option 5: SendGrid (Production API SMTP)
# - Free tier: 100 emails/day
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key

# Current Configuration (Hostinger Email)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=donotreply@246sports.com
SMTP_PASS="your-hostinger-mailbox-password"
EMAIL_FROM_NAME=246Sports
EMAIL_FROM_ADDRESS=donotreply@246sports.com
